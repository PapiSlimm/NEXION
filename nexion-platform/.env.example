# ---- Server ----
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ---- GitHub (delivery / CI signals) ----
# Personal access token or GitHub App token. Leave blank to run in sample mode.
GITHUB_TOKEN=
# For GitHub Enterprise Server, point at your API base, e.g. https://ghe.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# ---- Datadog (reliability / observability signals) ----
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# ---- Database / warehouse (Postgres wire protocol) ----
# Works with Postgres, Supabase, Neon, PlanetScale-for-Postgres.
# Append ?sslmode=require for managed providers.
DATABASE_URL=
DATABASE_MAX_ROWS=500
