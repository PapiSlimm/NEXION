{
  "name": "nexion-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NEXION / ORION / AEGIS — enterprise intelligence platform: REST API + MCP server with real integrations (GitHub, SQL databases, Datadog).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "api": "tsx src/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@octokit/rest": "^21.1.1",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
