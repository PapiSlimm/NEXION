# ---- Server ----
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ---- GitHub (delivery / CI signals) ----
# Personal access token or GitHub App token. Leave blank to run in sample mode.
GITHUB_TOKEN=
# For GitHub Enterprise Server, point at your API base, e.g. https://ghe.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# ---- Datadog (reliability / observability signals) ----
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# ---- Database / warehouse (Postgres wire protocol) ----
# Works with Postgres, Supabase, Neon, PlanetScale-for-Postgres.
# Append ?sslmode=require for managed providers.
DATABASE_URL=
DATABASE_MAX_ROWS=500

# ---- Governance & mission (Superior Generals Council) ----
# Hour (local, 0-23) for the daily governance sweep. 0 = midnight (00:00).
GOVERNANCE_SWEEP_HOUR=0
# Set false to disable the automatic daily sweep.
GOVERNANCE_ENABLE_SWEEP=true
# Allow webhook destinations to target private/internal hosts (DEV ONLY).
ALLOW_PRIVATE_WEBHOOK=false
# Mission: prioritize free-tier user acquisition when scoring outbound actions.
MISSION_PRIORITIZE_FREE_USERS=true
# Hard ceiling for any autonomous spend. 0 = no autonomous spend; every
# transaction requires explicit human approval (recommended).
MISSION_MAX_AUTONOMOUS_SPEND_USD=0
